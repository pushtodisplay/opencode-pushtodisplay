{
  "name": "opencode-pushtodisplay",
  "version": "0.1.0",
  "description": "Mirror OpenCode agent activity onto your Push To Display board as a shared, human-readable log (lifecycle, tasks, tool steps, alerts, errors)",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "pushtodisplay",
    "push-to-display",
    "display",
    "signage",
    "dashboard",
    "real-time",
    "status-board"
  ],
  "license": "MIT",
  "author": {
    "name": "Goban Source, LLC",
    "email": "hello@pushtodisplay.com",
    "url": "https://pushtodisplay.com"
  },
  "homepage": "https://pushtodisplay.com",
  "bugs": {
    "url": "https://github.com/pushtodisplay/opencode-pushtodisplay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushtodisplay/opencode-pushtodisplay.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.6",
    "pushtodisplay": "^0.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.59.1"
  }
}
